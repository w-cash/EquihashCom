# /etc/systemd/system/equihash-listings-refresh.timer
# Daily with a randomized offset. Enable with:
# systemctl enable --now equihash-listings-refresh.timer
[Unit]
Description=Daily equihash.com approved vendor listing refresh

[Timer]
OnCalendar=*-*-* 04:23:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
