# /etc/systemd/system/equihash-listings-refresh.service
[Unit]
Description=equihash.com approved vendor listing refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=equihash
Group=equihash
WorkingDirectory=/srv/equihash/current
Environment=DATA_DIR=/srv/equihash/data
ExecStart=/usr/bin/node scripts/refresh-vendor-listings.mjs
TimeoutStartSec=10min
Nice=10

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/equihash/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
